# 判断胖瘦的小程序（用 BMI 标准）
# BMI = 体重(公斤) ÷ 身高(米)的平方
# 中国标准：<18.5 偏瘦，18.5~24 正常，24~28 偏胖，>=28 肥胖


def wen_shu(zhi_shi, zui_xiao, zui_da):
    """反复询问，直到用户输入一个落在指定范围内的数字"""
    while True:
        try:
            shu = float(input(zhi_shi))
        except ValueError:
            print('输入的不是数字，请重新输入')
            continue
        if not (zui_xiao <= shu <= zui_da):
            print(f'请输入 {zui_xiao}~{zui_da} 之间的数字')
            continue
        return shu


def pan_duan(bmi):
    """根据 BMI 返回对应的体型描述"""
    if bmi < 18.5:
        return '偏瘦，多吃点'
    if bmi < 24:
        return '正常，保持住'
    if bmi < 28:
        return '偏胖，注意控制'
    return '肥胖，建议多运动'


def main():
    print('=== 测测你是胖还是瘦 ===')
    shen_gao = wen_shu('请输入身高（米），例如 1.75：', 0.5, 2.5)
    ti_zhong = wen_shu('请输入体重（公斤），例如 65：', 2, 500)

    bmi = ti_zhong / (shen_gao ** 2)
    print(f'你的 BMI 是：{bmi:.1f}')
    print(f'结果：{pan_duan(bmi)}')


if __name__ == '__main__':
    main()
